<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <!-- Format ID : C1, C2, C3... -->
  <xs:simpleType name="TypeIdCategorie">
    <xs:restriction base="xs:ID">
      <xs:pattern value="C[0-9]+"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Format ID : M001, M002... -->
  <xs:simpleType name="TypeIdMembre">
    <xs:restriction base="xs:ID">
      <xs:pattern value="M[0-9]{3}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Format ID : CO1, CO2... -->
  <xs:simpleType name="TypeIdConcours">
    <xs:restriction base="xs:ID">
      <xs:pattern value="CO[0-9]+"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Email doit contenir @ -->
  <xs:simpleType name="TypeEmail">
    <xs:restriction base="xs:string">
      <xs:pattern value="[^@]+@[^@]+"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Complexite : entier entre 0 et 100 -->
  <xs:simpleType name="TypeComplexite">
    <xs:restriction base="xs:integer">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="100"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- TempsExecution : entier strictement positif -->
  <xs:simpleType name="TypeTemps">
    <xs:restriction base="xs:integer">
      <xs:minExclusive value="0"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Coefficient : decimal strictement positif -->
  <xs:simpleType name="TypeCoefficient">
    <xs:restriction base="xs:decimal">
      <xs:minExclusive value="0"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Texte non vide -->
  <xs:simpleType name="TypeStringNonVide">
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:element name="club">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="categories" type="TypeCategories"/>
        <xs:element name="membres" type="TypeMembres"/>
        <xs:element name="concours" type="TypeListeConcours"/>
      </xs:sequence>
      <xs:attribute name="nom" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:complexType name="TypeCategories">
    <xs:sequence>
      <xs:element name="categorie" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="id"      type="TypeIdCategorie"   use="required"/>
          <xs:attribute name="libelle" type="TypeStringNonVide" use="required"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="TypeMembres">
    <xs:sequence>
      <xs:element name="membre" maxOccurs="unbounded">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="nom"    type="TypeStringNonVide"/>
            <xs:element name="prenom" type="TypeStringNonVide"/>
            <xs:element name="email"  type="TypeEmail"/>
          </xs:sequence>
          <xs:attribute name="id"           type="TypeIdMembre" use="required"/>
          <xs:attribute name="categorieRef" type="xs:IDREF"     use="required"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="TypeListeConcours">
    <xs:sequence>
      <xs:element name="concours" maxOccurs="unbounded">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="titre" type="TypeStringNonVide"/>
            <xs:element name="participants">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="participant" maxOccurs="unbounded">
                    <xs:complexType>
                      <xs:sequence>
                        <xs:element name="complexite"     type="TypeComplexite"/>
                        <xs:element name="tempsExecution" type="TypeTemps"/>
                      </xs:sequence>
                      <xs:attribute name="membreRef" type="xs:IDREF" use="required"/>
                    </xs:complexType>
                  </xs:element>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
          </xs:sequence>
          <xs:attribute name="id"           type="TypeIdConcours"  use="required"/>
          <xs:attribute name="categorieRef" type="xs:IDREF"        use="required"/>
          <xs:attribute name="date"         type="xs:date"         use="required"/>
          <xs:attribute name="coefficient"  type="TypeCoefficient" use="required"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

</xs:schema>